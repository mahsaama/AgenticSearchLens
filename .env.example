# Copy this file to .env and fill in whichever keys you need.
# Only required for the LLM-judge evaluations and invitro replay steps
# (see "Setup" in README.md) — extraction and descriptive analyses need none of these.

# LLM-judge evaluations (factuality/completeness/relevance, claim extraction,
# entailment, query-specificity, ...) and invitro replay of OpenAI models.
OPENAI_API_KEY=

# invitro replay of Claude models.
ANTHROPIC_API_KEY=

# invitro replay of Grok models.
XAI_API_KEY=

# invitro replay of DeepSeek models.
DEEPSEEK_API_KEY=

# Optional: override default API base URLs (e.g. for a proxy or gateway).
# OPENAI_BASE_URL=
# XAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# DEEPSEEK_ANTHROPIC_BASE_URL=
