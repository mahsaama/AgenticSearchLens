# Local environment config. This file is gitignored — fill in your own keys below.
# Only needed for the LLM-judge evaluations and invitro replay steps (see
# "Setup" in README.md); extraction and descriptive analyses need none of these.
#
# Everything below (besides the API keys) used to be duplicated as hardcoded
# fallbacks inside src/*.py (os.getenv("X", "default")). Those fallbacks have
# been removed from the code, so this file is now the only place the defaults
# live — the code just does os.getenv("X") and expects this file to be loaded.

# --- API keys (required for the steps that use them) -----------------------

# LLM-judge evaluations (factuality/completeness/relevance, claim extraction,
# entailment, query-specificity, ...) and invitro replay of OpenAI models.
OPENAI_API_KEY=
# invitro replay of Claude models.
ANTHROPIC_API_KEY=
# invitro replay of Grok models.
XAI_API_KEY=

# invitro replay of DeepSeek models.
DEEPSEEK_API_KEY=

# --- API base URLs -----------------------------------------------------------

# Leave OPENAI_BASE_URL and ANTHROPIC_BASE_URL unset/empty to use each SDK's
# own default endpoint; only set them to point at a proxy/gateway.
# NOTE: `KEY=` (no value) is NOT the same as unset -- python-dotenv loads it
# as os.environ["KEY"] = "", and both SDKs treat that empty string as an
# explicit (but invalid, scheme-less) base_url override instead of falling
# through to their built-in default, breaking every request with a generic
# "Connection error." Comment these out (don't just leave `KEY=`) to
# actually leave them unset.
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
XAI_BASE_URL=https://api.x.ai/v1
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# --- Replay tuning ------------------------------------------------------------

ANTHROPIC_MAX_TOKENS=1024

# --- Judge / claim-analysis models --------------------------------------------

CLAIM_ANALYSIS_MODEL=gpt-4o-mini
CLAIM_COMPARISON_JUDGE_MODEL=gpt-4o-mini
CLAIM_EXTRACTION_MODEL=gpt-4o-mini
CLAIM_EXTRACTION_MAX_INPUT_CHARS=24000
CLAIM_EXTRACTION_MAX_OUTPUT_TOKENS=1024
CLAIM_EXTRACTION_CACHE_PATH=outputs/chatgpt/metadata/response_source_claim_chunks_cache.json
FACTUALITY_JUDGE_MODEL=gpt-5.4-mini
FACTUALITY_JUDGE_MAX_OUTPUT_TOKENS=512

# --- Local NLI model for grounding evaluation ---------------------------------

BERT_NLI_MODEL_NAME=facebook/bart-large-mnli
BERT_NLI_MAX_LENGTH=512

# --- Cited-URL scraping timeouts, in seconds unless noted ---------------------

ARTICLE_REQUEST_TIMEOUT=12
ARTICLE_WIKIPEDIA_TIMEOUT=15
ARTICLE_PLAYWRIGHT_GOTO_TIMEOUT=20000       # milliseconds
ARTICLE_PLAYWRIGHT_NETWORKIDLE_TIMEOUT=4000 # milliseconds
ARTICLE_PLAYWRIGHT_FALLBACK_TIMEOUT=60
ARTICLE_URL_FETCH_TIMEOUT=60
ARTICLE_URL_CHECKPOINT_EVERY=100

# --- Replay web-tool name resolution (checked in this order; all optional) ---

REPLAY_WEB_TOOL_NAME=
WEB_TOOL_NAME=
MCP_SEARCH_PROVIDER=

# --- Logging -------------------------------------------------------------------

LOG_LEVEL=INFO
